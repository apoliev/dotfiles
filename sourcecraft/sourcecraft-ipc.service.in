[Unit]
Description=SourceCraft IPC (LLM gateway proxy)
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=@PATH@
@EXTRA_ENV@
Environment=SOURCECRAFT_IPC_API_KEY=@KEY@
ExecStart=@SRC_PATH@ ipc --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
